# ---------------------------------------------------------------------------
# Homify API — production environment template
#
#   cp .env.example .env
#   php artisan key:generate
#
# Never commit the resulting .env. Every value marked CHANGE_ME / <...> must be
# replaced before the API is reachable from the internet.
# ---------------------------------------------------------------------------

APP_NAME=Homify
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com

# Canonical marketing/OG/sitemap host (separate from APP_URL on purpose).
APP_PUBLIC_URL=https://example.com

# Reverse proxy / load balancer. nginx on the same host connects from
# 127.0.0.1. List exact IPs/CIDRs - never "*" in production, X-Forwarded-For
# would be spoofable.
TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
# `warning` hides every Log::info flow line (OTP sends, application submissions),
# which made failures look like they were never logged at all. `info` keeps the
# flow and still drops framework debug noise.
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Requests/minute per user (or IP) for the whole API group.
API_RATE_LIMIT=120

# MUST stay false anywhere real users can reach the API - the registration
# response would otherwise hand out login OTPs.
EXPOSE_DEV_OTP=false

# --- Database ---------------------------------------------------------------
# SQLite needs no server: one file, nothing to install. Create it once with
#   touch database/database.sqlite
# and leave DB_DATABASE unset to use database/database.sqlite.
DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/homify-api/database/database.sqlite

# PostgreSQL is also supported (and is what .env.testing.example targets):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=homify
# DB_USERNAME=homify
# DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- First-run seeding ------------------------------------------------------
# Used by Database\Seeders\AdminSeeder (php artisan db:seed).
# The seeded admin is user_id 1 on a fresh database, which is what
# PLATFORM_USER_ID expects. Leave ADMIN_PASSWORD empty and the seeder generates
# a strong one and prints it once - copy it out of the terminal.
ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@homify.com.np
ADMIN_PHONE=+977-9800000000
ADMIN_PASSWORD=

# System account that owns platform ledger entries. Must reference a real user.
# Defaults to the seeded admin (user_id 1).
PLATFORM_USER_ID=1

# --- Mail (password reset + email OTP) --------------------------------------
# 'log' silently drops password-reset and OTP mail.
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SCHEME=ssl
MAIL_USERNAME=resend
MAIL_PASSWORD=re_CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# --- SMS (Nepal) ------------------------------------------------------------
# sparrow for Nepali numbers, twilio for international. 'log' delivers nothing,
# so phone OTP login would only work for codes surfaced elsewhere.
SMS_GATEWAY=sparrow
SPARROW_SMS_TOKEN=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
SMS_FROM=Homify

# Send Expo pushes from a queue worker instead of inline.
NOTIFICATIONS_QUEUE_PUSH=true

# --- Payments ---------------------------------------------------------------
PAYMENT_DEFAULT_GATEWAY=khalti
PAYMENT_TIMEOUT_MINUTES=15
FRONTEND_URL=https://app.example.com

# Leave gateways disabled until live merchant keys are in place: an enabled
# gateway with placeholder keys fails every initiation with a 5xx.
KHALTI_ENABLED=false
KHALTI_BASE_URL=https://a.khalti.com/api/v2
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
KHALTI_WEBHOOK_KEY=

ESEWA_ENABLED=false
ESEWA_BASE_URL=https://epay.esewa.com.np
ESEWA_MERCHANT_CODE=
ESEWA_PRODUCT_CODE=
ESEWA_SECRET_KEY=
# UAT sandbox for testing: ESEWA_BASE_URL=https://uat.esewa.com.np

STRIPE_ENABLED=false
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

SERVICE_CHARGE_PERCENTAGE=5.0
PLATFORM_FEE_FIXED=25.0
TAX_PERCENTAGE=13.0

CASH_REMINDER_HOURS=24
CASH_ESCALATION_HOURS=72

MEMBERSHIP_PLAN_CODE=urban_plus
MEMBERSHIP_PENDING_MINUTES=15

REFERRAL_WELCOME_PERCENT=15
REFERRAL_REWARD_PERCENT=10
REFERRAL_MIN_ORDER_VALUE=500
REFERRAL_VALIDITY_DAYS=30

# Nightly pg_dump backups (db:backup). Leave empty when pg_dump is on PATH.
BACKUP_RETENTION_DAYS=14
PG_DUMP_BINARY=

VITE_APP_NAME="${APP_NAME}"
