# ============================================================================
#  Homify API — environment template
# ============================================================================
#
#  Quick start on a fresh checkout:
#
#     cp .env.example .env
#     php artisan key:generate
#     touch database/database.sqlite      # SQLite only (see the DB section)
#     php artisan migrate --force
#     php artisan db:seed --class=ProductionSeeder --force
#
#  Rules of thumb
#  --------------
#  * Never commit the resulting `.env`; it is gitignored.
#  * A value left empty that has no safe default (gateway keys, SMS token,
#    SMTP password) disables that feature instead of faking success.
#  * After editing, run `php artisan config:cache`. Laravel caches env values,
#    so a change that "did nothing" usually means the cache is stale.
#  * APP_ENV must be `production` on a public host: `local` + APP_DEBUG=true
#    prints stack traces, queries and secrets to anyone who triggers an error.
# ============================================================================


# ----------------------------------------------------------------------------
#  Application
# ----------------------------------------------------------------------------

APP_NAME=Homify
APP_ENV=production
APP_KEY=
APP_DEBUG=false

# Public origin of THIS API. Gateway callbacks (eSewa/Khalti), signed URLs and
# `php artisan` link generation are built from it, so it must be the host that
# actually reaches this server - https, no trailing slash.
APP_URL=https://api.example.com

# Canonical marketing site (landing page, OG tags, sitemap). Separate on
# purpose: crawlers and social cards point here, not at the API host.
APP_PUBLIC_URL=https://example.com

# Reverse proxy in front of PHP. nginx on the same host connects from
# 127.0.0.1; Cloudflare needs its published ranges. Comma-separated IPs/CIDRs.
# Never "*" in production: X-Forwarded-For would be spoofable, and every rate
# limit and audit IP is derived from it.
TRUSTED_PROXIES=127.0.0.1

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# Only needed after rotating APP_KEY: a comma-separated list of old keys so
# existing encrypted sessions/cookies can still be read while they expire.
# APP_PREVIOUS_KEYS=

BCRYPT_ROUNDS=12


# ----------------------------------------------------------------------------
#  Logging & error reporting
# ----------------------------------------------------------------------------
#
# Log files land in storage/logs. Both the API's own errors and the crash
# reports the mobile apps post to /api/v1/errors are written there, and the
# admin panel (System -> Error Reports / Login Activity) reads the same events.
#
# LEVEL MATTERS: `warning` (the old default) silently discards every Log::info
# flow line - OTP sends, partner submissions, admin logins. Those lines are how
# a failed request is diagnosed, so production runs at `info`.

LOG_CHANNEL=daily
LOG_STACK=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null


# ----------------------------------------------------------------------------
#  Abuse limits & auth policy
# ----------------------------------------------------------------------------

# Requests per minute per user (per IP when anonymous) for the whole API group.
API_RATE_LIMIT=120

# OTP sends/verifies allowed per IP in a 10-minute window. Per-address limits
# (3 sends, 5 verifies) still apply on top.
OTP_RATE_LIMIT=30

PASSWORD_MIN_LENGTH=8

# MUST stay false anywhere real users can reach the API: when true the
# registration response hands the login OTP straight to the caller.
EXPOSE_DEV_OTP=false

# Sanctum token settings. Stateful domains only matter for first-party browser
# clients; the mobile apps authenticate with bearer tokens.
# SANCTUM_STATEFUL_DOMAINS=example.com,localhost:8081
# SANCTUM_TOKEN_PREFIX=


# ----------------------------------------------------------------------------
#  Database
# ----------------------------------------------------------------------------
#
# SQLite needs no server: one file, nothing to install. Leave DB_DATABASE unset
# to use database/database.sqlite, and create that file once:
#
#     touch database/database.sqlite
#
# PostgreSQL is fully supported: comment out the SQLite line and uncomment the
# pgsql block below. Backups (`php artisan db:backup`) shell out to pg_dump, so
# they need pgsql.

DB_CONNECTION=sqlite
# DB_DATABASE=/var/www/homify-api/database/database.sqlite

# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=homify
# DB_USERNAME=homify
# DB_PASSWORD=CHANGE_ME
# Managed providers that terminate TLS often need these:
# DB_ENCRYPT=require
# DB_TRUST_SERVER_CERTIFICATE=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true once the admin panel is only served over https, so the session
# cookie is never sent on a plain-http request.
# SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log


# ----------------------------------------------------------------------------
#  First-run seeding
# ----------------------------------------------------------------------------
#
# Used by `php artisan db:seed --class=ProductionSeeder` (and AdminSeeder).
# Leave ADMIN_PASSWORD empty and the seeder generates a strong password and
# prints it ONCE - copy it out of the terminal before it scrolls away.

ADMIN_NAME="Super Admin"
ADMIN_EMAIL=admin@homify.com.np
ADMIN_PHONE=+977-9800000000
ADMIN_PASSWORD=

# System user that owns platform ledger rows (escrow, platform fee, VAT).
# Must reference a real row in `users`. On a fresh database the seeded admin is
# user_id 1; if yours differs, set it here or every ledger write fails the FK.
PLATFORM_USER_ID=1


# ----------------------------------------------------------------------------
#  Mail - email OTP, verification and password reset
# ----------------------------------------------------------------------------
#
# MAIL_MAILER=log does NOT send anything: it writes the message to the log and
# reports success, so verification codes would never reach a user. Use a real
# SMTP provider in production. These values are Resend's SMTP bridge; any
# provider works (MAIL_SCHEME and port must match: 465/ssl or 587/tls).

MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_SCHEME=ssl
MAIL_USERNAME=resend
MAIL_PASSWORD=re_CHANGE_ME
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="${APP_NAME}"


# ----------------------------------------------------------------------------
#  SMS - phone OTP and job alerts (Nepal)
# ----------------------------------------------------------------------------
#
# `sparrow` for Nepali numbers, `twilio` for international, `log` delivers
# nothing (codes only appear in the log).
#
# IMPORTANT: SmsService reads SMS_TOKEN for whichever gateway is selected - the
# Sparrow API token, or the Twilio auth token when SMS_GATEWAY=twilio. SMS_FROM
# is the Sparrow sender ID, or the Twilio from-number.
#
# Get the Sparrow token from https://sparrowsms.com -> API. A missing token
# makes every send fail with a 5xx from the provider.

SMS_GATEWAY=sparrow
SMS_TOKEN=
SMS_FROM=Homify

# Only for SMS_GATEWAY=twilio:
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ----------------------------------------------------------------------------
#  Push notifications
# ----------------------------------------------------------------------------
#
# Sending Expo pushes from the queue worker keeps a slow push provider out of
# the request path. Requires a running `php artisan queue:work` (there is a
# systemd unit in deploy/homify-queue.service). Keep false if no worker runs -
# queued pushes would sit in the jobs table forever.

NOTIFICATIONS_QUEUE_PUSH=true


# ----------------------------------------------------------------------------
#  Payments (Nepal: Khalti + eSewa, optional Stripe)
# ----------------------------------------------------------------------------
#
# Enable a gateway ONLY after its live keys are in place: an enabled gateway
# with placeholder keys fails every checkout with a 5xx. A disabled gateway is
# hidden from the app instead.

PAYMENT_DEFAULT_GATEWAY=khalti
PAYMENT_TIMEOUT_MINUTES=15

KHALTI_ENABLED=false
KHALTI_BASE_URL=https://a.khalti.com/api/v2
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
KHALTI_WEBHOOK_KEY=

ESEWA_ENABLED=false
ESEWA_BASE_URL=https://epay.esewa.com.np
# Where the signed payment form is hosted: production https://epay.esewa.com.np,
# UAT https://rc-epay.com.np (with ESEWA_BASE_URL=https://uat.esewa.com.np).
# Defaults to ESEWA_BASE_URL when unset.
# ESEWA_FORM_URL=
ESEWA_MERCHANT_CODE=
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=

STRIPE_ENABLED=false
STRIPE_BASE_URL=https://api.stripe.com/v1
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=


# ----------------------------------------------------------------------------
#  Pricing, cash settlement, membership and referrals
# ----------------------------------------------------------------------------

# Platform commission on every completed job, plus fixed fee and VAT.
SERVICE_CHARGE_PERCENTAGE=5.0
PLATFORM_FEE_FIXED=25.0
TAX_PERCENTAGE=13.0

# Pay-after-service jobs: nudge the customer after this many hours, escalate to
# support after the longer window. Never auto-confirm - cash is confirmed by the
# customer or a dispute.
CASH_REMINDER_HOURS=24
CASH_ESCALATION_HOURS=72

# Urban Plus membership: a pending purchase is abandoned after this window.
MEMBERSHIP_PLAN_CODE=urban_plus
MEMBERSHIP_PENDING_MINUTES=15

REFERRAL_WELCOME_PERCENT=15
REFERRAL_REWARD_PERCENT=10
REFERRAL_MIN_ORDER_VALUE=500
REFERRAL_VALIDITY_DAYS=30


# ----------------------------------------------------------------------------
#  Backups
# ----------------------------------------------------------------------------
#
# `php artisan db:backup` writes a compressed dump to storage/backups and prunes
# archives older than the retention window. PostgreSQL only; set PG_DUMP_BINARY
# when pg_dump is not on PATH (Windows installs).

BACKUP_RETENTION_DAYS=14
PG_DUMP_BINARY=
