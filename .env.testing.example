# ---------------------------------------------------------------------------
# Homify API — test environment template
#
#   cp .env.testing.example .env.testing
#   createdb homify_test        # or: CREATE DATABASE homify_test;
#   php artisan test
#
# The suite runs against PostgreSQL (the migrations use native ENUM types), so
# point DB_* at a dedicated, disposable database: RefreshDatabase wipes it.
# Never aim this at a database you care about.
#
# phpunit.xml already overrides cache/queue/session/mail per run; the values
# below exist so `php artisan`, tinker and single test classes behave the same
# way when run outside PHPUnit.
# ---------------------------------------------------------------------------

APP_NAME=Homify
APP_ENV=testing
APP_KEY=base64:WR4yf5k6bjRyfizKpPARkfcPmx2YcZdrQpsdCU0Pu7o=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

# Cheap hashing, so the auth tests are not dominated by bcrypt.
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Database (required) ----------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=homify_test
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Payments -----------------------------------------------------------------
# eSewa UAT credentials: public sandbox values, safe to commit and identical to
# the ones the gateway tests sign against.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://uat.esewa.com.np
ESEWA_FORM_URL=https://rc-epay.com.np

# Khalti is stubbed in tests; a placeholder key is enough.
KHALTI_BASE_URL=https://a.khalti.com/api/v2
KHALTI_SECRET_KEY=test_secret_key_placeholder
